{
  "name": "tools4us",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run build:data",
    "dev": "astro dev",
    "build": "npm run check:design && npm run build:data && astro build && npm run check:dist && pagefind --site dist",
    "check:data": "node scripts/build-data/cli.mjs check",
    "preview": "astro preview",
    "test:data": "node --test \"scripts/**/*.test.mjs\" \"src/**/*.test.mjs\"",
    "build:data": "node scripts/build-data/cli.mjs build",
    "migrate:legacy": "node scripts/build-data/migrate/cli.mjs",
    "audit:closure": "node scripts/build-data/audit-closure.mjs",
    "check:design": "node scripts/check-contrast.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.8",
    "pagefind": "^1.5.2"
  },
  "devDependencies": {
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^14.0.2"
  }
}
