{
  "name": "tools4us",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run build:data",
    "dev": "astro dev",
    "build": "npm run check:design && npm run build:data && astro build && npm run check:dist",
    "check:data": "node scripts/build-data/cli.mjs check",
    "preview": "astro preview",
    "test:data": "node --test \"scripts/**/*.test.mjs\" \"src/**/*.test.mjs\"",
    "build:data": "node scripts/build-data/cli.mjs build",
    "migrate:legacy": "node scripts/build-data/migrate/cli.mjs",
    "audit:closure": "node scripts/build-data/audit-closure.mjs",
    "check:design": "node scripts/check-contrast.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:freshness": "node scripts/freshness.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "kvkk:check": "node scripts/kvkk-check.mjs",
    "kvkk:text": "node scripts/kvkk-check.mjs --print",
    "review:export": "node scripts/review/cli.mjs export",
    "review:apply": "node scripts/review/cli.mjs apply"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "exceljs": "^4.4.0",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.14.0"
  },
  "overrides": {
    "uuid": "^14.0.2"
  }
}
