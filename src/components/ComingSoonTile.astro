---
// A visible but inactive tile: a feature or family that is planned, not built. Not a link on purpose.
interface Props {
  title: string;
  text?: string;
  badge: string;
  // Heading level, so tiles nest correctly under the heading above them.
  level?: 3 | 4;
}

const { title, text, badge, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
---

<div class="tile">
  <Heading>{title}</Heading>
  {text && <p>{text}</p>}
  <span class="badge">{badge}</span>
</div>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    background: var(--bg-soft);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-m);
  }

  .tile :global(h3),
  .tile :global(h4) {
    margin: 0;
    font-size: 1.0625rem;
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  .badge {
    margin-top: auto;
  }
</style>
