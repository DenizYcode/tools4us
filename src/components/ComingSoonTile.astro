---
// A visible but inactive tile: a feature or family that is planned, not built. Not a link on purpose.
interface Props {
  title: string;
  text?: string;
  badge: string;
}

const { title, text, badge } = Astro.props;
---

<div class="tile">
  <h3>{title}</h3>
  {text && <p>{text}</p>}
  <span class="badge">{badge}</span>
</div>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    background: var(--bg-soft);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-m);
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  .badge {
    margin-top: auto;
  }
</style>
