---
// Family page stub for families that are not built yet (Switching and Routing, Phase 4). It names the family
// and says what it is for, and never lists models: nothing is published until its rows are verified.
import Base from '../layouts/Base.astro';
import Section from './Section.astro';
import FamilyGraphic from './graphics/FamilyGraphic.astro';
import { t, localePath, type Lang } from '../i18n';
import { familySwitchPath, type Family } from '../i18n/routes';

interface Props {
  lang: Lang;
  family: Family;
}

const { lang, family } = Astro.props;
---

<Base lang={lang} title={`${t(lang, `family.${family}.name`)} · ${t(lang, 'site.name')}`} switchPath={familySwitchPath(lang, family)} current={family}>
  <Section tone="soft" labelledby="family-title">
    <div class="intro">
      <div>
        <h1 id="family-title">{t(lang, `family.${family}.title`)}</h1>
        <p class="lead">{t(lang, `family.${family}.blurb`)}</p>
      </div>
      <div class="art"><FamilyGraphic family={family} /></div>
    </div>
  </Section>
  <Section labelledby="soon-title">
    <h2 id="soon-title">{t(lang, 'family.soon.title')}</h2>
    <p class="note">{t(lang, 'family.soon.body')}</p>
    <p><a href={localePath(lang)}>← {t(lang, 'nav.back')}</a></p>
  </Section>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .lead {
    max-width: 36rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-lead);
  }

  .art {
    width: 100%;
    max-width: 26rem;
  }

  .note {
    max-width: 40rem;
    color: var(--muted);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  @media (min-width: 48em) {
    .intro {
      grid-template-columns: 1fr 22rem;
    }
  }
</style>
