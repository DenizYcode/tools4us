---
// One model on the family page: drawing, name, badges, one-line summary, compare box. The data-card attribute
// carries the few fields the filter script needs, so the filter logic is the same tested code as in src/lib.
import DeviceGraphic from './graphics/DeviceGraphic.astro';
import LifecycleBadge from './LifecycleBadge.astro';
import ShortlistButton from './ShortlistButton.astro';
import { t, tf, td, tp, type Lang } from '../i18n';
import { modelPath, type Family } from '../i18n/routes';
import { textOf, hasSixGhz, FAMILY_DATA, replacementCards, type Card } from '../lib/catalog';
import { FILTER_FIELDS } from '../lib/filters.mjs';
import { formatValue } from '../lib/format.mjs';

interface Props {
  lang: Lang;
  family: Family;
  card: Card;
}

const { lang, family, card } = Astro.props;
const filterData = Object.fromEntries(FILTER_FIELDS[family].map((field) => [field, card[field]]));
const current = card.lifecycle === 'current';
const replacements = current ? [] : replacementCards(card, FAMILY_DATA[family].lookup);
const why = card.recommended ? textOf(card, lang, 'recommended_why') : null;
const vals = tp(lang, 'val.');
const rate = (mbps: number) => formatValue('throughput_mbps', mbps, vals, lang);
// Graphic props are read from the card, so the drawing never disagrees with the specs.
const deviceKind = family === 'wireless' ? 'ap' : family === 'switching' ? 'switch' : 'router';
const deviceForm = family === 'switching' ? card.switch_form : card.form_factor?.includes('desktop') ? 'desktop' : 'rack';
---

<li class:list={['row', { old: !current }]} data-card={JSON.stringify(filterData)} data-slug={card.slug}>
  <div class="art">
    {family === 'wireless' && <DeviceGraphic kind="ap" environment={card.environment} wallPlate={card.wall_plate} externalAntennas={card.antenna_type === 'external' ? 2 : 0} ports={card.port_count ?? 1} />}
    {family === 'switching' && <DeviceGraphic kind="switch" form={deviceForm} ports={card.port_count ?? 8} uplinks={card.uplink_count ?? (card.modular_uplinks ? 2 : 4)} />}
    {family === 'routing' && <DeviceGraphic kind="router" form={deviceForm} ports={(card.lan_port_count ?? 0) + (card.wan_port_count ?? 0) || 4} uplinks={0} cellular={card.cellular !== 'none'} />}
  </div>
  <div class="main">
    <h3><a href={modelPath(lang, card.slug, family)}>{card.name}</a></h3>
    <p class="badges">
      <LifecycleBadge lang={lang} lifecycle={card.lifecycle} />
      {card.recommended && <span class="badge rec">{t(lang, 'badge.recommended')}</span>}
      {
        family === 'wireless' && (
          <>
            <span class="badge">{td(lang, `val.gen.${card.wifi_generation}`)}</span>
            <span class="badge">{td(lang, `val.env.${card.environment}`)}</span>
            {hasSixGhz(card) && <span class="badge">{t(lang, 'badge.sixghz')}</span>}
            {card.uplink_max_gbps !== null && card.uplink_max_gbps >= 2.5 && <span class="badge">{t(lang, 'badge.mgig')}</span>}
          </>
        )
      }
      {
        family === 'switching' && (
          <>
            <span class="badge">{tf(lang, 'badge.ports', { n: card.port_count ?? 0 })}</span>
            {card.poe && <span class="badge">{tf(lang, 'badge.poeW', { n: card.poe_budget_w })}</span>}
            {card.uplink_max_gbps && <span class="badge">{tf(lang, 'badge.uplink', { n: card.uplink_max_gbps })}</span>}
            {card.stacking && <span class="badge">{t(lang, 'badge.stack')}</span>}
            {card.mgig && <span class="badge">{t(lang, 'badge.mgig')}</span>}
            {card.layer3 !== 'l2' && <span class="badge">{t(lang, 'badge.l3')}</span>}
          </>
        )
      }
      {
        family === 'routing' && (
          <>
            {card.throughput_mbps && <span class="badge">{tf(lang, 'badge.rate', { n: rate(card.throughput_mbps) })}</span>}
            <span class="badge">{tf(lang, 'badge.wan', { n: card.wan_port_count ?? 0 })}</span>
            {card.sd_wan && <span class="badge">{t(lang, 'badge.sdwan')}</span>}
            {card.cellular !== 'none' && <span class="badge">{t(lang, 'badge.cellular')}</span>}
            {card.form_factor?.includes('virtual') && <span class="badge">{t(lang, 'badge.virtual')}</span>}
            {card.poe && <span class="badge">{t(lang, 'badge.poe')}</span>}
          </>
        )
      }
      {card.licence_required === true && <span class="badge">{t(lang, 'badge.licence')}</span>}
    </p>
    <p class="summary">{textOf(card, lang, 'summary')}</p>
    {why && <p class="why"><strong>{t(lang, 'badge.recommended')}:</strong> {why}</p>}
    {
      !current && (
        <p class="eos">
          {card.last_order && tf(lang, 'list.lastOrder', { date: card.last_order })}
          {replacements.length > 0 && (
            <>
              {' '}
              {t(lang, 'list.replacedBy')}{' '}
              {replacements.map((r, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={modelPath(lang, r.slug, family)}>{r.name}</a>
                </>
              ))}
            </>
          )}
        </p>
      )
    }
  </div>
  <div class="actions">
    <label class="cmp">
      <input type="checkbox" class="cmp-box" value={card.slug} aria-label={tf(lang, 'list.compareAddFor', { name: card.name })} />
      <span>{t(lang, 'list.compareAdd')}</span>
    </label>
    {current && <ShortlistButton lang={lang} family={family} slug={card.slug} name={card.name} />}
  </div>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    grid-template-areas:
      'art main'
      'cmp cmp';
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    list-style: none;
  }

  .row[hidden] {
    display: none;
  }

  .art {
    grid-area: art;
    align-self: start;
  }

  .main {
    grid-area: main;
    min-width: 0;
  }

  h3 {
    margin: 0 0 var(--space-2);
  }

  h3 a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--navy-900);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
  }

  .rec {
    background: var(--navy-900);
    color: var(--on-navy);
  }

  .summary {
    margin: 0 0 var(--space-2);
  }

  .why,
  .eos {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: var(--text-small);
  }

  .eos a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .actions {
    grid-area: cmp;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .cmp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    cursor: pointer;
    font-weight: 600;
  }

  .cmp input {
    width: 1.5rem;
    height: 1.5rem;
    accent-color: var(--accent);
  }

  .old {
    background: var(--bg-soft);
  }

  @media (min-width: 48em) {
    .row {
      grid-template-columns: 8rem 1fr auto;
      grid-template-areas: 'art main cmp';
      align-items: start;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
