---
// External link: opens in a new tab with an icon and a visually hidden note (ui.md).
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  href: string;
  // Analytics event to report when the link is used (a name from src/lib/track.mjs).
  track?: string;
}

const { lang, href, track } = Astro.props;
---

<a class="ext" href={href} data-track={track} target="_blank" rel="noopener noreferrer"
  ><slot /><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M6 3H3v10h10v-3M9 2h5v5M14 2 7 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg
  ><span class="sr">{t(lang, 'note.external')}</span></a
>

<style>
  .ext {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
