---
// The filter form of a family page, rendered from the panel definition in src/lib/filters.mjs. Plain checkboxes
// and radios: it works with the keyboard and the page script only reads it. Labels are plain Turkish, with the
// technical term beside the option.
import Term from './Term.astro';
import { t, td, type Lang } from '../i18n';
import { PANELS } from '../lib/filters.mjs';
import type { Family } from '../i18n/routes';

interface Props {
  lang: Lang;
  family: Family;
  // Which feature values exist in the published catalog (so the form never offers a dead option).
  features: string[];
}

const { lang, family, features } = Astro.props;
// Glossary key for the feature values that need an explanation.
const FEATURE_TERMS = new Set(['cleanair', 'security_radio', 'air_marshal', 'gnss_gps', 'uwb', 'urwb']);
const sections = PANELS[family]
  .map((section) => ({
    ...section,
    options: section.dynamic === 'features' ? features.map((value) => ({ value, label: `val.feature.${value}`, term: FEATURE_TERMS.has(value) ? value : undefined })) : section.options,
  }))
  .filter((section) => section.options.length > 0);
---

<form class="filters" id="filter-form" aria-labelledby="filters-title" novalidate>
  <a class="skip" href="#results-title">{t(lang, 'filters.skip')}</a>
  <div class="head">
    <h2 id="filters-title">{t(lang, 'filters.title')}</h2>
    <button type="button" class="close" id="filters-close">{t(lang, 'filters.close')}</button>
  </div>

  {
    sections.map((section) => (
      <fieldset>
        <legend>
          {td(lang, section.legend)}
          {section.legendTerm && <> <Term lang={lang} term={section.legendTerm} label="" idSuffix="-f" /></>}
        </legend>
        {section.hint && <p class="hint">{td(lang, section.hint)}</p>}
        {section.options.map((option, i) => (
          <div class="opt">
            <label>
              <input type={section.input} name={option.name ?? section.name} value={option.value} checked={section.input === 'radio' && i === 0} />
              <span>{td(lang, option.label)}</span>
            </label>
            {option.term && <Term lang={lang} term={option.term} label="" idSuffix="-f" />}
          </div>
        ))}
      </fieldset>
    ))
  }

  <fieldset>
    <div class="opt">
      <label>
        <input type="checkbox" name="showOld" value="1" />
        <span>{t(lang, 'filters.older')}</span>
      </label>
      <Term lang={lang} term="end_of_sale" label="" idSuffix="-f" />
    </div>
  </fieldset>

  <div class="actions">
    <button type="button" class="secondary" id="filters-clear">{t(lang, 'filters.clear')}</button>
    <button type="button" class="primary" id="filters-show">{t(lang, 'filters.show')}</button>
  </div>
</form>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Keyboard users can jump past the filter controls. Shown when focused. */
  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    position: static;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .head h2 {
    margin: 0;
    font-size: var(--text-h3);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--space-2);
    color: var(--navy-900);
    font-weight: 700;
  }

  .hint {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: var(--text-small);
  }

  .opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap);
  }

  .opt label {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    cursor: pointer;
  }

  .opt input {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    accent-color: var(--accent);
  }

  /* An open explanation sits under its row. */
  .opt :global(.term) {
    display: contents;
  }

  .opt :global(.tip) {
    flex-basis: 100%;
    order: 3;
  }

  .opt {
    flex-wrap: wrap;
  }

  button {
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border-radius: var(--radius-s);
    font: inherit;
    font-weight: 650;
    cursor: pointer;
  }

  .close,
  .secondary {
    background: var(--white);
    color: var(--accent-strong);
    border: 1px solid var(--border-strong);
  }

  .primary {
    background: var(--accent);
    color: var(--white);
    border: 1px solid var(--accent);
  }

  .primary:hover {
    background: var(--accent-strong);
  }

  .actions {
    display: flex;
    gap: var(--space-3);
  }

  .actions button {
    flex: 1;
  }

  /* On desktop the filters are a fixed column: the sheet buttons are not needed. */
  @media (min-width: 64em) {
    .close,
    #filters-show {
      display: none;
    }
  }
</style>
