---
// The filter form for the wireless family page. Plain checkboxes and radios: it works with the keyboard and
// the page script only reads it. Labels are plain Turkish, with the technical term beside the option.
import Term from './Term.astro';
import { t, td, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  // Which feature values exist in the published catalog (so the form never offers a dead option).
  features: string[];
}

const { lang, features } = Astro.props;
const MGMT = ['on_prem', 'cloud', 'unified', 'cisco_business'] as const;
const GEN = ['7', '6e', '6'] as const;
const ENV = ['indoor', 'outdoor'] as const;
const POE = ['af', 'at', 'bt'] as const;
// Glossary key for the terms that need an explanation, by filter value.
const TERM_FOR: Record<string, string> = { unified: 'unified', on_prem: 'on_prem', cloud: 'cloud', cisco_business: 'cisco_business', '7': 'wifi_7', '6e': 'wifi_6e', '6': 'wifi_6', af: 'poe_af', at: 'poe_at', bt: 'poe_bt', cleanair: 'cleanair', security_radio: 'security_radio', air_marshal: 'air_marshal', gnss_gps: 'gnss_gps', uwb: 'uwb', urwb: 'urwb' };
---

<form class="filters" id="filter-form" aria-labelledby="filters-title" novalidate>
  <div class="head">
    <h2 id="filters-title">{t(lang, 'filters.title')}</h2>
    <button type="button" class="close" id="filters-close">{t(lang, 'filters.close')}</button>
  </div>

  <fieldset>
    <legend>{t(lang, 'filters.mgmt')}</legend>
    {
      MGMT.map((value) => (
        <div class="opt">
          <label>
            <input type="checkbox" name="mgmt" value={value} />
            <span>{td(lang, `val.mgmt.${value}`)}</span>
          </label>
          {TERM_FOR[value] && <Term lang={lang} term={TERM_FOR[value]} label="" idSuffix="-f" />}
        </div>
      ))
    }
  </fieldset>

  <fieldset>
    <legend>{t(lang, 'filters.gen')}</legend>
    {
      GEN.map((value) => (
        <div class="opt">
          <label>
            <input type="checkbox" name="gen" value={value} />
            <span>{td(lang, `val.gen.${value}`)}</span>
          </label>
          <Term lang={lang} term={TERM_FOR[value]} label="" idSuffix="-f" />
        </div>
      ))
    }
  </fieldset>

  <fieldset>
    <legend>{t(lang, 'filters.env')}</legend>
    {
      ENV.map((value) => (
        <div class="opt">
          <label>
            <input type="checkbox" name="env" value={value} />
            <span>{td(lang, `val.env.${value}`)}</span>
          </label>
        </div>
      ))
    }
  </fieldset>

  <fieldset>
    <legend>{t(lang, 'filters.poe')} <Term lang={lang} term="poe" label="" idSuffix="-f" /></legend>
    <p class="hint">{t(lang, 'filters.poeHint')}</p>
    <div class="opt">
      <label>
        <input type="radio" name="poeMax" value="" checked />
        <span>{t(lang, 'filters.poeAny')}</span>
      </label>
    </div>
    {
      POE.map((value) => (
        <div class="opt">
          <label>
            <input type="radio" name="poeMax" value={value} />
            <span>{td(lang, `val.poe.${value}`)}</span>
          </label>
          <Term lang={lang} term={TERM_FOR[value]} label="" idSuffix="-f" />
        </div>
      ))
    }
  </fieldset>

  <fieldset>
    <legend>{t(lang, 'filters.extras')}</legend>
    <div class="opt">
      <label>
        <input type="checkbox" name="sixGhz" value="1" />
        <span>{t(lang, 'filters.sixghz')}</span>
      </label>
      <Term lang={lang} term="six_ghz" label="" idSuffix="-f" />
    </div>
    <div class="opt">
      <label>
        <input type="checkbox" name="mgig" value="1" />
        <span>{t(lang, 'filters.mgig')}</span>
      </label>
      <Term lang={lang} term="mgig" label="" idSuffix="-f" />
    </div>
  </fieldset>

  {
    features.length > 0 && (
      <fieldset>
        <legend>{t(lang, 'filters.features')}</legend>
        <p class="hint">{t(lang, 'filters.featuresHint')}</p>
        {features.map((value) => (
          <div class="opt">
            <label>
              <input type="checkbox" name="features" value={value} />
              <span>{td(lang, `val.feature.${value}`)}</span>
            </label>
            {TERM_FOR[value] && <Term lang={lang} term={TERM_FOR[value]} label="" idSuffix="-f" />}
          </div>
        ))}
      </fieldset>
    )
  }

  <fieldset>
    <div class="opt">
      <label>
        <input type="checkbox" name="showOld" value="1" />
        <span>{t(lang, 'filters.older')}</span>
      </label>
      <Term lang={lang} term="end_of_sale" label="" idSuffix="-f" />
    </div>
  </fieldset>

  <div class="actions">
    <button type="button" class="secondary" id="filters-clear">{t(lang, 'filters.clear')}</button>
    <button type="button" class="primary" id="filters-show">{t(lang, 'filters.show')}</button>
  </div>
</form>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .head h2 {
    margin: 0;
    font-size: var(--text-h3);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--space-2);
    color: var(--navy-900);
    font-weight: 700;
  }

  .hint {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: var(--text-small);
  }

  .opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap);
  }

  .opt label {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    cursor: pointer;
  }

  .opt input {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    accent-color: var(--accent);
  }

  /* An open explanation sits under its row. */
  .opt :global(.term) {
    display: contents;
  }

  .opt :global(.tip) {
    flex-basis: 100%;
    order: 3;
  }

  .opt {
    flex-wrap: wrap;
  }

  button {
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border-radius: var(--radius-s);
    font: inherit;
    font-weight: 650;
    cursor: pointer;
  }

  .close,
  .secondary {
    background: var(--white);
    color: var(--accent-strong);
    border: 1px solid var(--border-strong);
  }

  .primary {
    background: var(--accent);
    color: var(--white);
    border: 1px solid var(--accent);
  }

  .primary:hover {
    background: var(--accent-strong);
  }

  .actions {
    display: flex;
    gap: var(--space-3);
  }

  .actions button {
    flex: 1;
  }

  /* On desktop the filters are a fixed column: the sheet buttons are not needed. */
  @media (min-width: 64em) {
    .close,
    #filters-show {
      display: none;
    }
  }
</style>
