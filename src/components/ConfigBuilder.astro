---
// Configuration builder on a model page: the uplink modules that fit this exact model (verified pairs only),
// the slot limit and a live SKU string. A model without a verified pair shows nothing.
import Section from './Section.astro';
import Term from './Term.astro';
import { t, tf, td, tp, type Lang } from '../i18n';
import { FAMILY_DATA, type Card } from '../lib/catalog';
import { optionsFor, slotLimit, describe, buildSku } from '../lib/config-builder.mjs';
import type { Family } from '../i18n/routes';

interface Props {
  lang: Lang;
  family: Family;
  card: Card;
}

const { lang, family, card } = Astro.props;
const data = FAMILY_DATA[family];
const options = card.lifecycle === 'current' ? optionsFor(card.pids[0], data.accessories, data.compat) : [];
const limit = slotLimit(card, 'network_module');
const items = options.map((o) => ({ pid: o.pid, label: describe(o, lang) ?? o.pid, media: (o.media ?? []).map((m) => td(lang, `val.media.${m}`)).join(', ') }));
const strings = tp(lang, 'config.');
---

{
  items.length > 0 && limit > 0 && (
    <Section tone="soft" labelledby="config-title">
      <div id="config-root" data-model={card.pids[0]} data-limit={limit} data-strings={JSON.stringify(strings)}>
        <h2 id="config-title">{t(lang, 'config.title')} <Term lang={lang} term="uplink" label="" /></h2>
        <p>{tf(lang, 'config.lead', { n: limit })}</p>
        <form id="config-form">
          <fieldset>
            <legend>{t(lang, 'config.pick')}</legend>
            <label class="opt">
              <input type="radio" name="module" value="" checked />
              <span>{t(lang, 'config.none')}</span>
            </label>
            {items.map((item) => (
              <label class="opt">
                <input type="radio" name="module" value={item.pid} />
                <span><strong>{item.label}</strong> {item.media} <code>{item.pid}</code></span>
              </label>
            ))}
          </fieldset>
        </form>
        <p class="sku-label">{t(lang, 'config.sku')}</p>
        <p class="sku" id="config-sku" role="status" aria-live="polite"><code>{buildSku(card.pids[0], [])}</code></p>
        <p class="actions"><button type="button" id="config-copy">{t(lang, 'config.copy')}</button> <span id="config-status" role="status"></span></p>
        <p class="muted">{t(lang, 'config.note')}</p>
      </div>
    </Section>
  )
}

<style>
  .opt {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    cursor: pointer;
  }

  .opt input {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    accent-color: var(--accent);
  }

  fieldset {
    margin: 0 0 var(--space-4);
    padding: 0;
    border: 0;
  }

  legend {
    margin-bottom: var(--space-2);
    color: var(--navy-900);
    font-weight: 700;
  }

  .sku-label {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-small);
    font-weight: 650;
  }

  .sku {
    margin: var(--space-1) 0 var(--space-3);
    font-size: 1.125rem;
    overflow-wrap: anywhere;
  }

  code {
    padding: 0.125rem 0.375rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    font-size: 0.9375rem;
  }

  button {
    min-height: var(--tap);
    padding: 0 var(--space-4);
    background: var(--white);
    color: var(--accent-strong);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-s);
    font: inherit;
    font-weight: 650;
    cursor: pointer;
  }

  .muted {
    color: var(--muted);
  }
</style>

<script>
  import { buildSku } from '../lib/config-builder.mjs';

  const root = document.getElementById('config-root');
  if (root) {
    const model = root.dataset.model ?? '';
    const s = JSON.parse(root.dataset.strings ?? '{}') as Record<string, string>;
    const form = document.getElementById('config-form') as HTMLFormElement;
    const out = document.getElementById('config-sku') as HTMLElement;
    const status = document.getElementById('config-status') as HTMLElement;
    const sku = () => {
      const pick = String(new FormData(form).get('module') ?? '');
      return buildSku(model, pick ? [pick] : []);
    };
    form.addEventListener('change', () => {
      out.querySelector('code')!.textContent = sku();
      status.textContent = '';
    });
    document.getElementById('config-copy')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(sku());
        status.textContent = s['config.copied'];
      } catch {
        status.textContent = sku();
      }
    });
  }
</script>
