---
// Stand-in for a story card until stories exist (Phase 5). It invents no story: only the category
// tag and a "coming soon" note appear.
interface Props {
  category: string;
  text: string;
  badge: string;
}

const { category, text, badge } = Astro.props;
---

<article class="story">
  <div class="media" aria-hidden="true"></div>
  <div class="body">
    <h3 class="category">{category}</h3>
    <p class="text">{text}</p>
    <span class="badge">{badge}</span>
  </div>
</article>

<style>
  .story {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-m);
    overflow: hidden;
  }

  .media {
    height: 6.5rem;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(0 116 130 / 0.07) 14px 15px),
      var(--bg-tint);
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    flex: 1;
    padding: var(--space-5);
  }

  .category {
    margin: 0;
    color: var(--accent-strong);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .text {
    margin: 0;
    color: var(--muted);
  }

  .badge {
    margin-top: auto;
  }
</style>
