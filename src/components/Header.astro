---
import { t, localePath, type Lang } from '../i18n';
import { LAUNCH_FAMILIES, familyPath, comparePath, storiesPath, searchPath, shortlistPath, type Family } from '../i18n/routes';

interface Props {
  lang: Lang;
  // Full URL of the same page in the other language. Omit to hide the toggle.
  switchHref?: string;
  switchLang?: Lang;
  current?: Family | 'home' | 'compare' | 'stories' | 'search' | 'glossary' | 'shortlist';
}

const { lang, switchHref, switchLang, current } = Astro.props;
---

<header class="site-header">
  <div class="container inner">
    <a class="wordmark" href={localePath(lang)} aria-label={t(lang, 'nav.home')}>Tools<span class="four" aria-hidden="true">4</span>Us</a>
    <a class="tool-link" href={comparePath(lang)} aria-current={current === 'compare' ? 'page' : undefined}>{t(lang, 'compare.title')}</a>
    {
      switchHref !== undefined && switchLang && (
        <a class="lang-toggle" href={switchHref} lang={switchLang} hreflang={switchLang}>
          {t(lang, 'nav.switchTo')}
        </a>
      )
    }
    <nav class="families" aria-label={t(lang, 'nav.main')}>
      <ul>
        {
          LAUNCH_FAMILIES.map((family) => (
            <li>
              <a href={familyPath(lang, family)} aria-current={current === family ? 'page' : undefined}>
                {t(lang, `family.${family}.name`)}
              </a>
            </li>
          ))
        }
        <li>
          <a href={storiesPath(lang)} aria-current={current === 'stories' ? 'page' : undefined}>{t(lang, 'stories.title')}</a>
        </li>
        <li>
          <a href={searchPath(lang)} aria-current={current === 'search' ? 'page' : undefined}>{t(lang, 'nav.search')}</a>
        </li>
        <li>
          <a class="sl-link" href={shortlistPath(lang)} aria-current={current === 'shortlist' ? 'page' : undefined}>{t(lang, 'nav.shortlist')} <span class="sl-n" data-sl-count hidden></span></a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/shortlist';
</script>

<style>
  .site-header {
    background: var(--navy-900);
    color: var(--on-navy);
  }

  /* DOM order is wordmark, language toggle, family links on every screen width, and the layout shows them in that
     order too, so Tab follows what you see. On phones the links drop to a second row. */
  .inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas:
      'brand tool toggle'
      'nav nav nav';
    align-items: center;
    column-gap: var(--space-4);
  }

  .wordmark {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    justify-self: start;
    color: var(--on-navy);
    font-size: 1.375rem;
    font-weight: 780;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--on-navy);
  }

  .four {
    color: var(--accent-bright);
  }

  .tool-link {
    grid-area: tool;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--space-2);
    color: var(--on-navy-muted);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }

  .tool-link:hover {
    color: var(--on-navy);
  }

  .tool-link[aria-current='page'] {
    color: var(--on-navy);
    border-bottom-color: var(--accent-bright);
  }

  .lang-toggle {
    grid-area: toggle;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    padding-inline: var(--space-4);
    color: var(--on-navy);
    font-weight: 650;
    text-decoration: none;
    border: 1px solid var(--on-navy-muted);
    border-radius: var(--radius-s);
  }

  .lang-toggle:hover {
    background: var(--navy-700);
    color: var(--on-navy);
  }

  .families {
    grid-area: nav;
  }

  .families ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .families a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--on-navy-muted);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }

  .families a:hover {
    color: var(--on-navy);
  }

  .families a[aria-current='page'] {
    color: var(--on-navy);
    border-bottom-color: var(--accent-bright);
  }

  .sl-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    margin-inline-start: var(--space-2);
    padding-inline: var(--space-2);
    border-radius: 999px;
    background: var(--accent-bright);
    color: var(--navy-900);
    font-size: var(--text-small);
    font-weight: 700;
  }

  .sl-n[hidden] {
    display: none;
  }

  .site-header :focus-visible {
    outline-color: var(--focus-on-navy);
  }

  @media (min-width: 48em) {
    .inner {
      grid-template-columns: auto auto auto 1fr;
      grid-template-areas: 'brand tool toggle nav';
      column-gap: var(--space-6);
      min-height: 3.5rem;
    }

    .families {
      justify-self: end;
    }
  }
</style>
