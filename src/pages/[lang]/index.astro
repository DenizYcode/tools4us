---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import FamilyCard from '../../components/FamilyCard.astro';
import ComingSoonTile from '../../components/ComingSoonTile.astro';
import StoryCard from '../../components/StoryCard.astro';
import ShortcutLink from '../../components/ShortcutLink.astro';
import SelectorShortcut from '../../components/SelectorShortcut.astro';
import HeroGraphic from '../../components/graphics/HeroGraphic.astro';
import { locales, t, type Lang } from '../../i18n';
import { LAUNCH_FAMILIES, LATER_FAMILIES, comparePath, storiesPath, searchPath } from '../../i18n/routes';
import { hubStories } from '../../lib/stories';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const stories = hubStories();
const shortcuts = ['recommend', 'legacy', 'compare'] as const;
const shortcutHref = { compare: comparePath(lang) } as const;
---

<Base lang={lang} title={`${t(lang, 'site.name')}: ${t(lang, 'hero.title')}`} switchPath="" current="home">
  <Section tone="navy" labelledby="hero-title" class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t(lang, 'hero.eyebrow')}</p>
        <h1 id="hero-title">{t(lang, 'hero.title')}</h1>
        <p class="lead">{t(lang, 'hero.lead')}</p>
        <form class="hero-search" role="search" method="get" action={searchPath(lang)}>
          <label for="hero-q">{t(lang, 'hero.search.label')}</label>
          <div class="hero-search-row">
            <input id="hero-q" name="q" type="search" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" placeholder={t(lang, 'hero.search.placeholder')} />
            <button type="submit">{t(lang, 'search.button')}</button>
          </div>
        </form>
        <a class="button" href="#families">{t(lang, 'hero.cta')}</a>
      </div>
      <div class="hero-art"><HeroGraphic /></div>
    </div>
  </Section>

  <Section labelledby="families-title">
    <h2 id="families" class="anchor">
      <span id="families-title">{t(lang, 'families.title')}</span>
    </h2>
    <ul class="grid three">
      {
        LAUNCH_FAMILIES.map((family) => (
          <li>
            <FamilyCard lang={lang} family={family} />
          </li>
        ))
      }
    </ul>
    <h3 class="later-title">{t(lang, 'families.later')}</h3>
    <ul class="grid three later">
      {
        LATER_FAMILIES.map((family) => (
          <li>
            <ComingSoonTile level={4} title={t(lang, `tbd.${family}`)} badge={t(lang, 'soon.badge')} />
          </li>
        ))
      }
    </ul>
  </Section>

  {
    stories.length > 0 && (
      <Section tone="soft" labelledby="stories-title">
        <h2 id="stories-title">{t(lang, 'stories.title')}</h2>
        <ul class="grid stories">
          {stories.map((story) => (
            <li>
              <StoryCard lang={lang} story={story} />
            </li>
          ))}
        </ul>
        <p class="all-stories">
          <a href={storiesPath(lang)}>{t(lang, 'stories.allLink')} →</a>
        </p>
      </Section>
    )
  }

  <Section labelledby="shortcuts-title">
    <h2 id="shortcuts-title">{t(lang, 'shortcuts.title')}</h2>
    <ul class="grid three">
      {
        shortcuts.map((shortcut) => (
          <li>
            {shortcut === 'legacy' ? (
              <ComingSoonTile title={t(lang, `shortcuts.${shortcut}.title`)} text={t(lang, `shortcuts.${shortcut}.body`)} badge={t(lang, 'soon.badge')} />
            ) : shortcut === 'recommend' ? (
              <SelectorShortcut lang={lang} title={t(lang, 'shortcuts.recommend.title')} text={t(lang, 'shortcuts.recommend.body')} />
            ) : (
              <ShortcutLink href={shortcutHref.compare} title={t(lang, `shortcuts.${shortcut}.title`)} text={t(lang, `shortcuts.${shortcut}.body`)} cta={t(lang, 'compare.title')} />
            )}
          </li>
        ))
      }
    </ul>
  </Section>
</Base>

<style>
  .hero-grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--accent-bright);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lead {
    max-width: 38rem;
    margin-bottom: var(--space-5);
    color: var(--on-navy-muted);
    font-size: var(--text-lead);
  }

  .hero-search {
    max-width: 34rem;
    margin-bottom: var(--space-5);
  }

  .hero-search label {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--on-navy);
    font-weight: 650;
  }

  .hero-search-row {
    display: flex;
    gap: var(--space-2);
  }

  .hero-search input {
    flex: 1;
    min-width: 0;
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 2px solid var(--on-navy-muted);
    border-radius: var(--radius-s);
    background: var(--white);
    color: var(--ink);
    font: inherit;
  }

  .hero-search button {
    min-height: var(--tap);
    padding: 0 var(--space-5);
    border: 2px solid var(--accent-bright);
    border-radius: var(--radius-s);
    background: var(--accent);
    color: var(--white);
    font: inherit;
    font-weight: 650;
    cursor: pointer;
  }

  .hero-search button:hover {
    background: var(--accent-strong);
  }

  .hero-search :focus-visible {
    outline-color: var(--focus-on-navy);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-5);
    background: var(--accent);
    color: var(--white);
    font-weight: 650;
    text-decoration: none;
    border-radius: var(--radius-s);
    border: 2px solid var(--accent-bright);
  }

  .button:hover {
    background: var(--accent-strong);
    color: var(--white);
  }

  .hero-art {
    max-width: 30rem;
    justify-self: center;
    width: 100%;
  }

  .anchor {
    scroll-margin-top: var(--space-5);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Cards in a row share one height. */
  .grid > li > :global(*) {
    height: 100%;
  }

  .later-title {
    margin: var(--space-7) 0 var(--space-4);
    color: var(--muted);
  }

  .later .grid,
  .later {
    gap: var(--space-4);
  }

  .all-stories {
    margin: var(--space-5) 0 0;
  }

  .all-stories a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 650;
  }

  @media (min-width: 40em) {
    .grid.stories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .grid.stories {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 56em) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
