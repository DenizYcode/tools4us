---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/inter/wght-italic.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, otherLang, localePath, type Lang } from '../i18n';
import { SITE_CONFIG } from '../lib/site-config.mjs';
import type { Family } from '../i18n/routes';

interface Props {
  // Language of the page chrome. Pages that show both languages (root, 404) pass bilingual.
  lang: Lang;
  title: string;
  bilingual?: boolean;
  // Path after /<lang>/ for the same page in the other language (e.g. "kablosuz/"). Omit to hide the toggle.
  switchPath?: string;
  // One sentence for search results and link previews. Defaults to the site tagline.
  description?: string;
  // Tool pages whose content is personal or empty until used (search, shortlist, compare) and the 404 page.
  noindex?: boolean;
  ogType?: 'website' | 'article';
  current?: Family | 'home' | 'compare' | 'stories' | 'search' | 'glossary' | 'shortlist' | 'migration';
}

const { lang, title, bilingual = false, switchPath, current, description, noindex = false, ogType = 'website' } = Astro.props;
const other = otherLang(lang);
const footerLangs: Lang[] = bilingual ? ['tr', 'en'] : [lang];
const switchHref = switchPath === undefined ? undefined : localePath(other, switchPath);

// Absolute addresses for the search engines and link previews. The bilingual pages (root redirect, 404) have no single language.
const clip = (text: string, max = 160) => (text.length <= max ? text : `${text.slice(0, max - 1).replace(/\s+\S*$/, '')}…`);
const abs = (path: string) => new URL(path, Astro.site).href;
const summary = clip(description ?? t(lang, 'site.tagline'));
const canonical = bilingual ? undefined : abs(Astro.url.pathname);
const alternate = switchHref === undefined ? undefined : abs(switchHref);
const image = abs(`${import.meta.env.BASE_URL}social-preview.png`);
const locale = { tr: 'tr_TR', en: 'en_US' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && alternate && <link rel="alternate" hreflang={lang} href={canonical} />}
    {canonical && alternate && <link rel="alternate" hreflang={other} href={alternate} />}
    {canonical && alternate && <link rel="alternate" hreflang="x-default" href={lang === 'tr' ? canonical : alternate} />}
    <meta property="og:site_name" content={t(lang, 'site.name')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={locale[lang]} />
    {canonical && alternate && <meta property="og:locale:alternate" content={locale[other]} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t(lang, 'site.name')}: ${t(lang, 'site.tagline')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#0a1f44" />
    <title>{title}</title>
    {/* Preload the upright Inter files: Turkish letters (ı ş ğ İ) live in latin-ext, and a late font swap moves the text. */}
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    {lang === 'tr' || bilingual ? <link rel="preload" as="font" type="font/woff2" href={interLatinExt} crossorigin /> : null}
    <slot name="head" />
  </head>
  <body
    data-sl-add={t(lang, 'shortlist.add')}
    data-sl-in={t(lang, 'shortlist.in')}
    data-sl-remove-for={t(lang, 'shortlist.removeFor')}
    data-sl-added={t(lang, 'shortlist.added')}
    data-sl-removed={t(lang, 'shortlist.removed')}
    data-sl-full={t(lang, 'shortlist.full')}
    data-sl-save-failed={t(lang, 'shortlist.saveFailed')}
    data-sl-link={t(lang, 'nav.shortlist')}
    data-sl-counted={t(lang, 'shortlist.count')}
    data-gc-endpoint={SITE_CONFIG.goatcounter.endpoint}
    data-gc-src={`${import.meta.env.BASE_URL}vendor/goatcounter/count.js`}
  >
    <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} switchHref={switchHref} switchLang={other} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer langs={footerLangs} />
    <p id="sl-live" class="visually-hidden" role="status" aria-live="polite"></p>
  </body>
</html>

<script>
  import '../scripts/track';
</script>
